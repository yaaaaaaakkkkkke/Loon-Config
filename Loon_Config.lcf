[Remote Rule]
# 应用分流（沿用 kelee/LoonLab 规则集，与 iBL3ND 的应用维度保持一致）
https://rule.kelee.one/Loon/WeChat.lsr, policy=DIRECT, tag=WeChat, enabled=true
https://loon.103516.xyz/Rule/Apple.lsr, policy=Apple, tag=Apple, enabled=true
https://loon.103516.xyz/Rule/AI.lsr, policy=AI, tag=AI, enabled=true
https://loon.103516.xyz/Rule/TikTok.lsr, policy=TikTok, tag=TikTok, enabled=true
