时延优选 = url-test,Hong Kong,Japan,South Korea,Singapore,United States,interval = 300,tolerance = 50,img-url = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/Other/UrlTest.png
故障转移 = fallback,Hong Kong,Japan,South Korea,Singapore,United States,interval = 300,max-timeout = 1500,img-url = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/Other/Fallback.png
Hong Kong = url-test,Sub-HK,interval = 300,tolerance = 50,img-url = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/Flag/HongKong.png
